{
  "name": "@pydantic/monty",
  "version": "0.0.18",
  "type": "module",
  "description": "Sandboxed Python interpreter running in crash-isolated subprocess workers",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pydantic/monty"
  },
  "license": "MIT",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">= 20"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "generate-proto": "buf generate",
    "format": "prettier . -w",
    "lint": "oxlint .",
    "test": "ava",
    "smoke-test": "bash scripts/smoke-test.sh",
    "create-platform-packages": "node scripts/create-platform-packages.mjs"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.10.1"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.58.0",
    "@bufbuild/protoc-gen-es": "^2.10.1",
    "@oxc-node/core": "^0.0.35",
    "@types/node": "^25.0.9",
    "ava": "^6.4.1",
    "oxlint": "^1.14.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  },
  "ava": {
    "extensions": {
      "ts": "module"
    },
    "timeout": "2m",
    "workerThreads": false,
    "nodeArguments": [
      "--import",
      "@oxc-node/core/register"
    ]
  },
  "prettier": {
    "printWidth": 120,
    "semi": false,
    "trailingComma": "all",
    "singleQuote": true,
    "arrowParens": "always"
  },
  "optionalDependencies": {
    "@pydantic/monty-darwin-x64": "0.0.18",
    "@pydantic/monty-darwin-arm64": "0.0.18",
    "@pydantic/monty-linux-x64-gnu": "0.0.18",
    "@pydantic/monty-linux-arm64-gnu": "0.0.18",
    "@pydantic/monty-win32-x64-msvc": "0.0.18"
  }
}
