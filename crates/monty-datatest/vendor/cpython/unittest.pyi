from collections.abc import Callable
from re import Pattern
from typing import Generic, NoReturn, ParamSpec, TypeVar, overload

_T = TypeVar('_T')
_U = TypeVar('_U')
_E = TypeVar('_E', bound=BaseException)
_P = ParamSpec('_P')

class _Context(Generic[_T]):
    def __enter__(self) -> _T: ...
    def __exit__(self, exc_type: object, exc: object, traceback: object) -> bool: ...

class _Raised(Generic[_E]):
    exception: _E

class TestCase:
    def fail(self, msg: object = None) -> NoReturn: ...
    def assertEqual(self, first: object, second: object, msg: str | None = None) -> None: ...
    def assertNotEqual(self, first: object, second: object, msg: str | None = None) -> None: ...
    def assertListEqual(self, first: list[_T], second: list[_U], msg: str | None = None) -> None: ...
    def assertAlmostEqual(self, first: complex, second: complex, places: int | None = None) -> None: ...
    def assertTrue(self, expr: object, msg: str | None = None) -> None: ...
    def assertFalse(self, expr: object, msg: str | None = None) -> None: ...
    def assertIn(self, member: object, container: object, msg: str | None = None) -> None: ...
    def assertNotIn(self, member: object, container: object, msg: str | None = None) -> None: ...
    def assertIs(self, first: object, second: object, msg: str | None = None) -> None: ...
    def assertIsNone(self, obj: object, msg: str | None = None) -> None: ...
    def assertIsInstance(self, obj: object, cls: type | tuple[type, ...], msg: str | None = None) -> None: ...
    def assertIsSubclass(self, cls: type, superclass: type | tuple[type, ...], msg: str | None = None) -> None: ...
    def assertGreaterEqual(self, a: _T, b: _T, msg: str | None = None) -> None: ...
    def assertRegex(self, text: str, expected_regex: str | Pattern[str], msg: str | None = None) -> None: ...
    def assertStartsWith(self, s: str, prefix: str | tuple[str, ...], msg: str | None = None) -> None: ...
    def assertHasAttr(self, obj: object, name: str, msg: str | None = None) -> None: ...
    def assertNotHasAttr(self, obj: object, name: str, msg: str | None = None) -> None: ...
    @overload
    def assertRaises(self, expected_exception: type[_E], /) -> _Context[_Raised[_E]]: ...
    @overload
    def assertRaises(
        self,
        expected_exception: type[BaseException],
        function: Callable[_P, object],
        /,
        *args: _P.args,
        **kwargs: _P.kwargs,
    ) -> None: ...
    @overload
    def assertRaisesRegex(
        self, expected_exception: type[_E], expected_regex: str | Pattern[str], /
    ) -> _Context[_Raised[_E]]: ...
    @overload
    def assertRaisesRegex(
        self,
        expected_exception: type[BaseException],
        expected_regex: str | Pattern[str],
        function: Callable[_P, object],
        /,
        *args: _P.args,
        **kwargs: _P.kwargs,
    ) -> None: ...
    def assertWarns(self, expected_warning: type[BaseException], /) -> _Context[object]: ...
    def assertWarnsRegex(self, expected_warning: type[BaseException], expected_regex: str, /) -> _Context[object]: ...
    def skipTest(self, reason: object) -> NoReturn: ...
    def addCleanup(self, function: Callable[_P, object], /, *args: _P.args, **kwargs: _P.kwargs) -> None: ...
    def subTest(self, msg: object = ..., **params: object) -> _Context[None]: ...

def main() -> None: ...
