The dir tests deliberately pass too many arguments and attach new attributes to instances. Imports of mounted fixtures are not resolved by the type checker.

--- a/test/test_builtin.py
+++ b/test/test_builtin.py
@@ -680,7 +680,7 @@
 
     def test_dir(self):
         # dir(wrong number of arguments)
-        self.assertRaises(TypeError, dir, 42, 42)
+        self.assertRaises(TypeError, dir, 42, 42)  # ty: ignore[too-many-positional-arguments]
 
         # dir() - local scope
         local_var = 1
