"""Monty's `fnmatch`: the four functions, without 3.14's `filterfalse` or `__all__`.
`fnmatch()` and `filter()`'s pattern go through `os.fspath`, so they take a path too."""

from collections.abc import Iterable
from os import PathLike
from typing import AnyStr

def fnmatch(name: AnyStr | PathLike[AnyStr], pat: AnyStr | PathLike[AnyStr]) -> bool: ...
def fnmatchcase(name: AnyStr, pat: AnyStr) -> bool: ...
def filter(names: Iterable[AnyStr], pat: AnyStr | PathLike[AnyStr]) -> list[AnyStr]: ...
def translate(pat: str) -> str: ...
