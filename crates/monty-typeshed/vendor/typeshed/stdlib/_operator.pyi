"""Monty's native `_operator`: the accelerator behind `operator`.
Left out: `length_hint`, `delitem`, `imatmul`, `_compare_digest`, `inv`, `is_none` and `is_not_none`."""

from collections.abc import Callable, Container, Iterable
from typing import Any, SupportsAbs, SupportsIndex, final

def add(a: Any, b: Any, /) -> Any: ...
def sub(a: Any, b: Any, /) -> Any: ...
def mul(a: Any, b: Any, /) -> Any: ...
def truediv(a: Any, b: Any, /) -> Any: ...
def floordiv(a: Any, b: Any, /) -> Any: ...
def mod(a: Any, b: Any, /) -> Any: ...
def pow(a: Any, b: Any, /) -> Any: ...
def matmul(a: Any, b: Any, /) -> Any: ...
def and_(a: Any, b: Any, /) -> Any: ...
def or_(a: Any, b: Any, /) -> Any: ...
def xor(a: Any, b: Any, /) -> Any: ...
def lshift(a: Any, b: Any, /) -> Any: ...
def rshift(a: Any, b: Any, /) -> Any: ...
def neg(a: Any, /) -> Any: ...
def pos(a: Any, /) -> Any: ...
def invert(a: Any, /) -> Any: ...
def abs(a: SupportsAbs[Any], /) -> Any: ...
def index(a: SupportsIndex, /) -> int: ...
def eq(a: object, b: object, /) -> Any: ...
def ne(a: object, b: object, /) -> Any: ...
def lt(a: Any, b: Any, /) -> Any: ...
def le(a: Any, b: Any, /) -> Any: ...
def gt(a: Any, b: Any, /) -> Any: ...
def ge(a: Any, b: Any, /) -> Any: ...
def not_(a: object, /) -> bool: ...
def truth(a: object, /) -> bool: ...
def is_(a: object, b: object, /) -> bool: ...
def is_not(a: object, b: object, /) -> bool: ...
def contains(a: Container[object], b: object, /) -> bool: ...
def getitem(a: Any, b: Any, /) -> Any: ...
def concat(a: Any, b: Any, /) -> Any: ...
def countOf(a: Iterable[object], b: object, /) -> int: ...
def indexOf(a: Iterable[object], b: object, /) -> int: ...
def setitem(a: Any, b: Any, c: Any, /) -> None: ...
def iadd(a: Any, b: Any, /) -> Any: ...
def isub(a: Any, b: Any, /) -> Any: ...
def imul(a: Any, b: Any, /) -> Any: ...
def itruediv(a: Any, b: Any, /) -> Any: ...
def ifloordiv(a: Any, b: Any, /) -> Any: ...
def imod(a: Any, b: Any, /) -> Any: ...
def ipow(a: Any, b: Any, /) -> Any: ...
def iand(a: Any, b: Any, /) -> Any: ...
def ior(a: Any, b: Any, /) -> Any: ...
def ixor(a: Any, b: Any, /) -> Any: ...
def ilshift(a: Any, b: Any, /) -> Any: ...
def irshift(a: Any, b: Any, /) -> Any: ...
def iconcat(a: Any, b: Any, /) -> Any: ...
def call(obj: Callable[..., Any], /, *args: Any, **kwargs: Any) -> Any: ...

@final
class itemgetter:
    def __new__(cls, item: Any, /, *items: Any) -> itemgetter: ...
    def __call__(self, obj: Any, /) -> Any: ...

@final
class attrgetter:
    def __new__(cls, attr: str, /, *attrs: str) -> attrgetter: ...
    def __call__(self, obj: Any, /) -> Any: ...

@final
class methodcaller:
    def __new__(cls, name: str, /, *args: Any, **kwargs: Any) -> methodcaller: ...
    def __call__(self, obj: Any, /) -> Any: ...
