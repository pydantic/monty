# Monty's `time` module: the clocks, `sleep()`, the conversion functions and the
# four zone constants it implements at runtime (see `crates/monty/src/modules/time.rs`).
# Upstream typeshed's `stdlib/time.pyi` is not vendored: `tzset`,
# `get_clock_info`, `clock_gettime`/`clock_settime` and the `CLOCK_*` constants
# have no runtime behind them, and `struct_time` is not a name in the module.
from typing import final

timezone: int
altzone: int
daylight: int
tzname: tuple[str, str]

@final
class _StructTime(tuple[int | str | None, ...]):
    """What `gmtime()`, `localtime()` and `strptime()` return.

    Unlike CPython's, `tm_gmtoff` and `tm_zone` are tuple items too, so `len()`
    is 11, and `time.struct_time` is not available as a name at runtime.
    """

    @property
    def tm_year(self) -> int: ...
    @property
    def tm_mon(self) -> int: ...
    @property
    def tm_mday(self) -> int: ...
    @property
    def tm_hour(self) -> int: ...
    @property
    def tm_min(self) -> int: ...
    @property
    def tm_sec(self) -> int: ...
    @property
    def tm_wday(self) -> int: ...
    @property
    def tm_yday(self) -> int: ...
    @property
    def tm_isdst(self) -> int: ...
    @property
    def tm_gmtoff(self) -> int | None: ...
    @property
    def tm_zone(self) -> str | None: ...

_TimeTuple = tuple[int, int, int, int, int, int, int, int, int]

def time() -> float: ...
def time_ns() -> int: ...
def monotonic() -> float: ...
def monotonic_ns() -> int: ...
def perf_counter() -> float: ...
def perf_counter_ns() -> int: ...
def process_time() -> float: ...
def process_time_ns() -> int: ...
def thread_time() -> float: ...
def thread_time_ns() -> int: ...
def sleep(seconds: float, /) -> None: ...
def gmtime(seconds: float | None = None, /) -> _StructTime: ...
def localtime(seconds: float | None = None, /) -> _StructTime: ...
def mktime(time_tuple: _TimeTuple | _StructTime, /) -> float: ...
def asctime(time_tuple: _TimeTuple | _StructTime = ..., /) -> str: ...
def ctime(seconds: float | None = None, /) -> str: ...
def strftime(format: str, time_tuple: _TimeTuple | _StructTime = ..., /) -> str: ...
def strptime(data_string: str, format: str = '%a %b %d %H:%M:%S %Y', /) -> _StructTime: ...
