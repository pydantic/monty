"""Monty's `statistics`: the common descriptive functions on `int`/`float` data.
`NormalDist`, `kde`, `geometric_mean`, `harmonic_mean`, `median_grouped`, `covariance`,
`correlation` and `linear_regression` are not provided."""

from collections.abc import Hashable, Iterable
from typing import Literal, SupportsFloat, TypeVar

from _typeshed import SupportsRichComparisonT

_HashableT = TypeVar('_HashableT', bound=Hashable)

class StatisticsError(ValueError): ...

def mean(data: Iterable[float]) -> float: ...
def fmean(data: Iterable[SupportsFloat], weights: Iterable[SupportsFloat] | None = None) -> float: ...
def median(data: Iterable[float]) -> float: ...
def median_low(data: Iterable[SupportsRichComparisonT]) -> SupportsRichComparisonT: ...
def median_high(data: Iterable[SupportsRichComparisonT]) -> SupportsRichComparisonT: ...
def mode(data: Iterable[_HashableT]) -> _HashableT: ...
def multimode(data: Iterable[_HashableT]) -> list[_HashableT]: ...
def pstdev(data: Iterable[float], mu: float | None = None) -> float: ...
def pvariance(data: Iterable[float], mu: float | None = None) -> float: ...
def stdev(data: Iterable[float], xbar: float | None = None) -> float: ...
def variance(data: Iterable[float], xbar: float | None = None) -> float: ...
def quantiles(
    data: Iterable[float], *, n: int = 4, method: Literal['inclusive', 'exclusive'] = 'exclusive'
) -> list[float]: ...
