+def b2a_uu(data: bytes, /, *, backtick: bool = False) -> bytes: ...
+def a2b_uu(data: str | bytes, /) -> bytes: ...
+def b2a_qp(data: bytes, quotetabs: bool = False, istext: bool = True, header: bool = False) -> bytes: ...
