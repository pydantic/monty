+# Based on python/typeshed's `stdlib/binascii.pyi`, cut down to what Monty
+# exposes at runtime. Extend in lockstep with
+# `crates/monty/src/modules/binascii.rs`.
+#
+# Parameters typed `ReadableBuffer` upstream are `bytes` here: Monty has no
+# `bytearray` or `memoryview`.
 
 class Error(ValueError): ...
 class Incomplete(Exception): ...
